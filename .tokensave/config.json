{
  "version": 1,
  "root_dir": "F:\\Github Repository Projects\\AtlantisNexus",
  "exclude": [
    "**/target/**",
    "**/.git/**",
    "**/.tokensave/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/vendor/**",
    "**/*.min.*",
    "**/*.tsbuildinfo",
    "**/build/**",
    "**/out/**",
    "**/.gradle/**",
    "**/site-packages/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "server/dist/**",
    "server/coverage/**",
    "bin/**"
  ],
  "include": [],
  "max_file_size": 1048576,
  "extract_docstrings": true,
  "track_call_sites": true,
  "git_ignore": true,
  "default_path_include": [],
  "default_path_exclude": [],
  "source_path_overrides": [],
  "docs_dir": "tokensave-docs",
  "last_indexed_version": "7.12.1",
  "auto_track": false,
  "strict_tree": false,
  "max_auto_sync_files": 2000,
  "report_savings": true,
  "artifact_extensions": [
    "feature",
    "json",
    "yaml",
    "yml",
    "sql",
    "toml",
    "proto",
    "graphql",
    "md",
    "scss",
    "prisma"
  ],
  "suppress_scope_warning": false
}
